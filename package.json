{
  "name": "@caplugins/capacitor-health",
  "version": "0.0.1",
  "description": "Apple HealthKit and Google Health Connect for Capacitor: every data type, read and write, with reproductive health first",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources",
    "ios/Tests",
    "Package.swift",
    "CapluginsCapacitorHealth.podspec",
    "CHANGELOG.md"
  ],
  "author": "Vish <hello@iamvishnu.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caplugins/capacitor-health.git"
  },
  "bugs": {
    "url": "https://github.com/caplugins/capacitor-health/issues"
  },
  "homepage": "https://github.com/caplugins/capacitor-health#readme",
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "health",
    "healthkit",
    "health-connect",
    "apple-health",
    "menstrual-cycle",
    "reproductive-health",
    "fitness",
    "ios",
    "android"
  ],
  "scripts": {
    "verify": "npm run registry:check && npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "xcodebuild -scheme CapluginsCapacitorHealth -destination generic/platform=iOS -packageAuthorizationProvider netrc",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build",
    "test": "vitest run",
    "registry:gen": "node scripts/gen-registry.mjs",
    "registry:check": "node scripts/gen-registry.mjs --check",
    "registry:coverage": "node scripts/coverage.mjs",
    "test:ios": "xcodebuild test -scheme CapluginsCapacitorHealth -destination \"${IOS_DESTINATION:-platform=iOS Simulator,name=iPhone 17 Pro}\" -packageAuthorizationProvider netrc",
    "test:android": "cd android && ./gradlew test && cd ..",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api CapacitorHealthPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.0.0",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.0.0",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "ajv": "^8.20.0",
    "eslint": "^8.57.1",
    "prettier": "^3.6.2",
    "prettier-plugin-java": "^2.7.7",
    "rimraf": "^6.1.0",
    "rollup": "^4.53.2",
    "swiftlint": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "@capacitor/core": "^8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
