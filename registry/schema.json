{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/caplugins/capacitor-health/registry/schema.json",
  "title": "capacitor-health type registry",
  "description": "Single source for every unified health type (decision #12). scripts/gen-registry.mjs turns it into the TypeScript, Swift and Kotlin registries. Semantic checks the schema can't express (cross-references, maps covering every value) live in scripts/lib/registry.mjs.",
  "type": "object",
  "required": ["units", "valueSets", "types"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "units": {
      "description": "Every unit a type can use, keyed by the unified unit id apps pass and get back.",
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[A-Za-z%][A-Za-z0-9/()·%]*$" },
      "additionalProperties": { "$ref": "#/$defs/unitDef" }
    },
    "valueSets": {
      "description": "Enumerations shared by types and fields, keyed by name.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/camelId" },
      "additionalProperties": { "$ref": "#/$defs/valueSet" }
    },
    "nutrients": {
      "description": "Nutrients of a nutrition entry (NutritionRecord properties ⇄ HealthKit dietary quantity types), keyed by the unified nutrient id.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/camelId" },
      "additionalProperties": { "$ref": "#/$defs/nutrient" }
    },
    "workoutActivities": {
      "description": "Workout activity types (decision #62): unified activity id → HKWorkoutActivityType case and Health Connect EXERCISE_TYPE_* constant.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/camelId" },
      "additionalProperties": { "$ref": "#/$defs/workoutActivity" }
    },
    "types": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/type" }
    }
  },
  "$defs": {
    "unitDef": {
      "type": "object",
      "required": ["dimension"],
      "additionalProperties": false,
      "properties": {
        "dimension": { "description": "Units of one type must share a dimension.", "$ref": "#/$defs/camelId" },
        "ios": {
          "description": "HKUnit string (HKUnit(from:)); the generated XCTest checks each type's units are compatible with its HealthKit type. Absent: no HealthKit unit.",
          "type": "string",
          "minLength": 1
        },
        "percent": { "description": "0–100 across the bridge, 0–1 in HealthKit (decision #15).", "const": true },
        "android": {
          "description": "How Health Connect holds the value. Absent: no Health Connect unit.",
          "type": "object",
          "required": ["class"],
          "additionalProperties": false,
          "properties": {
            "class": {
              "description": "Number: a plain Long / Double property. Otherwise the androidx.health.connect.client.units class.",
              "enum": ["Number", "Length", "Energy", "Mass", "Temperature", "TemperatureDelta", "Percentage", "Pressure", "BloodGlucose", "Velocity", "Power", "Volume"]
            },
            "factory": { "description": "Companion factory, e.g. meters.", "$ref": "#/$defs/camelId" },
            "accessor": { "description": "Property reading the value back, e.g. inMeters.", "$ref": "#/$defs/camelId" },
            "scale": { "description": "Factory units per one of this unit (cm → 0.01 with meters).", "type": "number", "exclusiveMinimum": 0 }
          },
          "allOf": [
            {
              "if": { "properties": { "class": { "enum": ["Number", "Percentage"] } } },
              "then": { "not": { "anyOf": [{ "required": ["factory"] }, { "required": ["accessor"] }] } },
              "else": { "required": ["factory", "accessor"] }
            }
          ]
        },
        "notes": { "$ref": "#/$defs/notes" }
      }
    },
    "camelId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "osVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "notes": { "type": "string", "minLength": 1 },
    "unit": { "description": "A key of the top-level units table.", "type": "string", "minLength": 1 },
    "hcConstant": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "hcPermission": { "type": "string", "pattern": "^android\\.permission\\.health\\.(READ|WRITE)_[A-Z0-9_]+$" },

    "valueSet": {
      "type": "object",
      "required": ["values"],
      "additionalProperties": false,
      "properties": {
        "values": {
          "description": "Unified values, in display order.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/camelId" }
        },
        "ios": {
          "type": "object",
          "required": ["enum", "minOS", "map"],
          "additionalProperties": false,
          "properties": {
            "enum": {
              "description": "The HealthKit enum holding the raw values (pinned by the generated XCTest).",
              "type": "string",
              "pattern": "^HK[A-Za-z0-9]+$"
            },
            "minOS": { "$ref": "#/$defs/osVersion" },
            "map": {
              "description": "Unified value → raw value. null = no HealthKit equivalent (writes reject, reads never produce it).",
              "type": "object",
              "additionalProperties": { "type": ["integer", "null"] }
            },
            "valueMinOS": {
              "description": "Values whose enum case is newer than the set's minOS.",
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/osVersion" }
            },
            "cases": {
              "description": "Swift case name where it differs from the unified value.",
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/camelId" }
            },
            "notes": { "$ref": "#/$defs/notes" }
          }
        },
        "android": {
          "type": "object",
          "required": ["constants", "map"],
          "additionalProperties": false,
          "properties": {
            "constants": {
              "description": "Class in androidx.health.connect.client.records holding the constants.",
              "type": "string",
              "pattern": "^[A-Z][A-Za-z0-9]+$"
            },
            "map": {
              "description": "Unified value → constant name. null = no Health Connect equivalent.",
              "type": "object",
              "additionalProperties": { "oneOf": [{ "$ref": "#/$defs/hcConstant" }, { "type": "null" }] }
            },
            "absent": {
              "description": "Constant meaning 'not recorded'. Reads map it to an absent field; writes without the field use it (decision #33).",
              "$ref": "#/$defs/hcConstant"
            },
            "notes": { "$ref": "#/$defs/notes" }
          }
        },
        "notes": { "$ref": "#/$defs/notes" }
      }
    },

    "field": {
      "description": "A typed field beyond the main value (decision #20).",
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["boolean", "enum"] },
        "values": { "description": "Value set name, for enum fields.", "$ref": "#/$defs/camelId" },
        "ios": {
          "type": "object",
          "required": ["metadata", "key"],
          "additionalProperties": false,
          "properties": {
            "metadata": { "description": "Swift symbol of the metadata key.", "type": "string", "pattern": "^HKMetadataKey[A-Za-z0-9]+$" },
            "key": { "description": "Runtime string of the key (differs from the symbol for iOS 8/9 keys, T06 S7).", "type": "string", "pattern": "^HK[A-Za-z0-9]+$" },
            "requiredOnWrite": { "type": "boolean" }
          }
        },
        "android": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "property": { "description": "Record property holding the value.", "$ref": "#/$defs/camelId" },
            "computed": { "description": "Derived by the plugin, not stored on the record.", "type": "string", "minLength": 1 },
            "constants": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
            "true": { "$ref": "#/$defs/hcConstant" },
            "false": { "$ref": "#/$defs/hcConstant" },
            "absent": { "$ref": "#/$defs/hcConstant" }
          },
          "oneOf": [{ "required": ["property"] }, { "required": ["computed"] }]
        },
        "notes": { "$ref": "#/$defs/notes" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "enum" } } }, "then": { "required": ["values"] } },
        { "if": { "properties": { "type": { "const": "boolean" } } }, "then": { "not": { "required": ["values"] } } }
      ]
    },

    "part": {
      "description": "One child array of a session (decision #61).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "values": { "description": "Value set of each child's type (a sleep stage, a segment type).", "$ref": "#/$defs/camelId" },
        "ios": { "description": "How HealthKit holds the children.", "$ref": "#/$defs/notes" },
        "android": { "description": "How Health Connect holds the children.", "$ref": "#/$defs/notes" },
        "notes": { "$ref": "#/$defs/notes" }
      }
    },

    "workoutActivity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ios": {
          "type": "object",
          "required": ["case", "raw", "minOS"],
          "additionalProperties": false,
          "properties": {
            "case": { "description": "Swift case of HKWorkoutActivityType (pinned by the generated XCTest).", "$ref": "#/$defs/camelId" },
            "raw": { "type": "integer", "minimum": 0 },
            "minOS": { "$ref": "#/$defs/osVersion" },
            "indoor": { "description": "HKMetadataKeyIndoorWorkout: true matches and writes indoor; false matches absent or false and writes false.", "type": "boolean" },
            "swimmingLocation": { "description": "HKMetadataKeySwimmingLocationType it matches and writes.", "enum": ["pool", "openWater"] }
          },
          "not": { "required": ["indoor", "swimmingLocation"] }
        },
        "android": {
          "type": "object",
          "required": ["constant"],
          "additionalProperties": false,
          "properties": { "constant": { "description": "ExerciseSessionRecord constant.", "$ref": "#/$defs/hcConstant" } }
        },
        "notes": { "$ref": "#/$defs/notes" }
      },
      "anyOf": [{ "required": ["ios"] }, { "required": ["android"] }]
    },

    "nutrient": {
      "type": "object",
      "required": ["unit"],
      "additionalProperties": false,
      "properties": {
        "unit": { "description": "Canonical unit (g or kcal); any unit of the same dimension works.", "$ref": "#/$defs/unit" },
        "ios": {
          "type": "object",
          "required": ["identifier", "minOS"],
          "additionalProperties": false,
          "properties": {
            "identifier": { "type": "string", "pattern": "^HKQuantityTypeIdentifierDietary[A-Za-z0-9]+$" },
            "minOS": { "$ref": "#/$defs/osVersion" }
          }
        },
        "android": {
          "type": "object",
          "required": ["property", "aggregate"],
          "additionalProperties": false,
          "properties": {
            "property": { "description": "NutritionRecord property (and constructor argument).", "$ref": "#/$defs/camelId" },
            "aggregate": { "description": "NutritionRecord AggregateMetric constant summing it.", "$ref": "#/$defs/hcConstant" }
          }
        },
        "notes": { "$ref": "#/$defs/notes" }
      },
      "anyOf": [{ "required": ["ios"] }, { "required": ["android"] }]
    },

    "type": {
      "type": "object",
      "required": ["id", "kind", "group"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/camelId" },
        "kind": {
          "description": "quantity: number + unit. category: one value from a value set. event: no value, only start/end. special: bespoke codec in Special/ (still registered).",
          "enum": ["quantity", "category", "event", "special"]
        },
        "group": { "enum": ["reproductiveHealth", "symptoms", "activity", "vitals", "body", "sleep", "nutrition", "mindfulness", "other"] },
        "values": { "description": "Value set name of the main value (category kind).", "$ref": "#/$defs/camelId" },
        "unit": { "description": "Canonical unit returned by default.", "$ref": "#/$defs/unit" },
        "units": { "description": "Units callers may ask for.", "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/unit" } },
        "fields": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/camelId" },
          "additionalProperties": { "$ref": "#/$defs/field" }
        },
        "parts": {
          "description": "Child arrays of a special type (sleep stages, workout segments and laps), keyed by the sample property holding them.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/camelId" },
          "additionalProperties": { "$ref": "#/$defs/part" }
        },
        "ios": { "$ref": "#/$defs/iosMapping" },
        "android": { "$ref": "#/$defs/androidMapping" },
        "notes": { "$ref": "#/$defs/notes" }
      },
      "anyOf": [{ "required": ["ios"] }, { "required": ["android"] }],
      "allOf": [
        { "if": { "properties": { "kind": { "const": "category" } } }, "then": { "required": ["values"] } },
        { "if": { "properties": { "kind": { "const": "quantity" } } }, "then": { "required": ["unit", "units"] } },
        {
          "if": { "properties": { "kind": { "enum": ["event", "quantity"] } } },
          "then": { "not": { "required": ["values"] } }
        }
      ]
    },

    "iosMapping": {
      "type": "object",
      "required": ["minOS", "writable"],
      "oneOf": [{ "required": ["identifier"] }, { "required": ["members"] }],
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "description": "The HealthKit identifier constant, named as in the SDK headers. Its string is the runtime identifier unless rawValue says otherwise. For a derived type, the identifier it's derived from (authorization uses it).",
          "type": "string",
          "pattern": "^HK(Category|Quantity|Correlation)TypeIdentifier[A-Z][A-Za-z0-9]*$"
        },
        "rawValue": {
          "description": "The identifier's runtime string when it isn't the constant's name (Apple renamed the constant and kept the old string). Runtime lookups use it.",
          "type": "string",
          "pattern": "^HK(Category|Quantity|Correlation)TypeIdentifier[A-Z][A-Za-z0-9]*$"
        },
        "minOS": { "$ref": "#/$defs/osVersion" },
        "writable": { "type": "boolean" },
        "time": {
          "description": "any: start ≤ end (default). instant: start must equal end or the save fails. interval: end must be at least a second after start (HealthKit raises an exception below its minimum duration, 1 ms for the audio exposure types; a second keeps clear of rounding).",
          "enum": ["any", "instant", "interval"]
        },
        "range": {
          "description": "Values HealthKit accepts, in the type's only unit (bridge scale). Outside it HealthKit raises an exception, which would crash the app, so writes outside it are rejected first.",
          "type": "object",
          "required": ["min", "max"],
          "additionalProperties": false,
          "properties": { "min": { "type": "number" }, "max": { "type": "number" } }
        },
        "aggregation": {
          "description": "HKQuantityAggregationStyle, quantity types only.",
          "enum": ["cumulative", "discreteArithmetic", "discreteTemporallyWeighted", "discreteEquivalentContinuousLevel"]
        },
        "derivedFrom": { "description": "Unified id this type is derived from (no HealthKit object of its own).", "$ref": "#/$defs/camelId" },
        "members": {
          "description": "Combined id (decision #14): the unified ids whose HealthKit types it reads together.",
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/camelId" }
        },
        "writeTo": { "description": "Combined id: the member a write goes to unless the sample names a member.", "$ref": "#/$defs/camelId" },
        "aggregateOnly": { "description": "No samples of its own: only aggregate() serves it (decision #21).", "type": "boolean" },
        "metrics": {
          "description": "aggregate() metrics the plugin computes itself for a special type, without HealthKit statistics (sleep sessions' duration, decision #65).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["sum", "avg", "min", "max", "count", "duration"] }
        },
        "notes": { "$ref": "#/$defs/notes" }
      }
    },

    "androidMapping": {
      "type": "object",
      "required": ["record", "time", "readPermission", "writePermission", "writable"],
      "additionalProperties": false,
      "properties": {
        "record": { "description": "Class in androidx.health.connect.client.records.", "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*Record$" },
        "time": { "enum": ["instant", "interval", "series"] },
        "readPermission": { "$ref": "#/$defs/hcPermission" },
        "writePermission": { "$ref": "#/$defs/hcPermission" },
        "writable": { "type": "boolean" },
        "valueProperty": { "description": "Record property holding the main value.", "$ref": "#/$defs/camelId" },
        "feature": { "description": "HealthConnectFeatures constant gating the record.", "type": "string", "pattern": "^FEATURE_[A-Z_]+$" },
        "maxDurationDays": { "description": "Longest interval the record accepts (inclusive).", "type": "integer", "minimum": 1 },
        "aggregates": {
          "description": "aggregate() metric → AggregateMetric constant on the record class.",
          "type": "object",
          "propertyNames": { "enum": ["sum", "avg", "min", "max", "count", "duration"] },
          "additionalProperties": { "$ref": "#/$defs/hcConstant" }
        },
        "aggregateOnly": { "description": "Readable only through aggregate(); the record gives the permissions (decision #21).", "type": "boolean" },
        "wholeNumber": { "description": "The value property is a Long: writes reject fractions.", "type": "boolean" },
        "notes": { "$ref": "#/$defs/notes" }
      }
    }
  }
}
